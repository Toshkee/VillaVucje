# Security headers everywhere. Cloudflare merges every matching rule, so
# Cache-Control must not be set here as well: a /* value would be concatenated
# onto the /_astro/* one and the shortest max-age would win.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Content-hashed build output: cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
