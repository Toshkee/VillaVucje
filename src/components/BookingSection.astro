---
import { anchors, t, type Locale } from '@config/i18n';
import { activeProviders } from '@config/property';
import ExternalIcon from './ExternalIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const labels = { booking: tr.cta.booking, airbnb: tr.cta.airbnb } as const;
const rules = [tr.booking.noSmoking, tr.booking.noPets, tr.booking.noParties];
---

<section id={anchors[locale].booking} class="section booking on-dark" aria-labelledby="booking-title" data-bar-stop>
  <div class="container">
    <div class="booking-grid">
      <div class="booking-text" data-reveal>
        <h2 id="booking-title">{tr.booking.heading}</h2>
        <p>{tr.booking.body}</p>
        {
          activeProviders.length > 0 && (
            <div class="booking-actions">
              {activeProviders.map((provider, i) => (
                <a
                  class:list={['btn', i === 0 ? 'btn-light' : 'btn-outline-light']}
                  href={provider.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {labels[provider.id]}
                  <ExternalIcon />
                  <span class="visually-hidden">({tr.cta.newTab})</span>
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div class="booking-rules" data-reveal data-reveal-delay="80">
        <details name="stay-info" open>
          <summary>{tr.booking.arrivalHeading}<span class="disclosure-icon" aria-hidden="true"></span></summary>
          <div class="disclosure-content">
            <p>{tr.booking.checkIn}<br />{tr.booking.checkOut}</p>
          </div>
        </details>
        <details name="stay-info">
          <summary>{tr.booking.rulesHeading}<span class="disclosure-icon" aria-hidden="true"></span></summary>
          <div class="disclosure-content">
            <ul>{rules.map((rule) => <li>{rule}</li>)}</ul>
          </div>
        </details>
        <details name="stay-info">
          <summary>{tr.booking.reservationHeading}<span class="disclosure-icon" aria-hidden="true"></span></summary>
          <div class="disclosure-content"><p>{tr.booking.body}</p></div>
        </details>
      </div>
    </div>
  </div>
</section>

<style>
  .booking {
    background: var(--forest);
    color: var(--ivory);
  }

  .booking h2 {
    color: var(--ivory);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    letter-spacing: -0.04em;
  }

  .booking p {
    margin-top: 1.1rem;
    color: rgba(245, 241, 232, 0.86);
  }

  .booking-grid {
    display: grid;
    gap: 2rem;
  }

  .booking-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .booking-actions .btn {
    width: 100%;
  }

  /* Sona UI disclosure pattern, implemented with native keyboard-accessible details. */
  .booking-rules details {
    margin-bottom: 0.6rem;
    padding: 0 1rem;
    background: rgb(245 241 232 / 7%);
    border-radius: var(--radius);
    transition: background var(--dur) var(--ease);
  }

  .booking-rules details[open] {
    background: rgb(245 241 232 / 11%);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
    font-size: 1.1rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .disclosure-icon {
    position: relative;
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .disclosure-icon::before,
  .disclosure-icon::after {
    content: '';
    position: absolute;
    top: calc(50% - 1px);
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform var(--dur) var(--ease);
  }

  .disclosure-icon::after {
    transform: rotate(90deg);
  }

  details[open] .disclosure-icon::after {
    transform: rotate(0);
  }

  .disclosure-content {
    padding-bottom: 1rem;
  }

  .disclosure-content p {
    margin: 0;
  }

  @supports (interpolate-size: allow-keywords) {
    details::details-content {
      interpolate-size: allow-keywords;
      height: 0;
      overflow: clip;
      transition: height var(--dur) var(--ease), content-visibility var(--dur) allow-discrete;
    }

    details[open]::details-content {
      height: auto;
    }
  }

  .booking-rules ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .booking-rules li {
    padding: 0.25rem 0;
    color: rgba(245, 241, 232, 0.9);
  }

  @media (min-width: 30em) {
    .booking-actions .btn {
      width: auto;
    }
  }

  @media (min-width: 60em) {
    .booking-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
  }
</style>
