---
import { anchors, t, type Locale } from '@config/i18n';
import { activeProviders, property } from '@config/property';
import ExternalIcon from './ExternalIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const labels = { booking: tr.cta.booking, airbnb: tr.cta.airbnb } as const;
const rules = [tr.booking.noSmoking, tr.booking.noPets, tr.booking.noParties];
const r = property.houseRules;
---

<section id={anchors[locale].booking} class="section booking on-dark" aria-labelledby="booking-title" data-bar-stop>
  <div class="container booking-grid">
    <div class="booking-text" data-reveal>
      <h2 id="booking-title">
        {tr.booking.heading}
        <span class="accent">{tr.booking.headingAccent}</span>
      </h2>
      <p class="booking-lede">{tr.booking.body}</p>
      <h3>{tr.booking.reservationHeading}</h3>
      <p>{tr.booking.reservationBody}</p>
    </div>

    <div class="booking-card" data-reveal data-reveal-delay="100">
      <p class="card-name">
        <svg class="mark" aria-hidden="true" viewBox="0 0 28 22" fill="none">
          <path d="M2 14 14 3l12 11" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>
          <path d="M6 12.5V20h16v-7.5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
        </svg>
        <span>
          <span class="name">Villa Vučje</span>
          <span class="place">{tr.hero.location}</span>
        </span>
      </p>

      <dl class="times">
        <div>
          <dt>{tr.booking.checkIn}</dt>
          <dd>{r.checkInFrom}–{r.checkInUntil}</dd>
        </div>
        <div>
          <dt>{tr.booking.checkOut}</dt>
          <dd>{r.checkOutFrom}–{r.checkOutUntil}</dd>
        </div>
      </dl>

      {
        activeProviders.length > 0 && (
          <div class="booking-actions">
            {activeProviders.map((provider, i) => (
              <a
                class:list={['btn', i === 0 ? 'btn-dark' : 'btn-secondary']}
                href={provider.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {labels[provider.id]}
                <ExternalIcon />
                <span class="visually-hidden">({tr.cta.newTab})</span>
              </a>
            ))}
          </div>
        )
      }

      <div class="rules">
        <h3>{tr.booking.rulesHeading}</h3>
        <ul>{rules.map((rule) => <li>{rule}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .booking {
    background: var(--forest);
    color: var(--ivory);
  }

  .booking-grid {
    display: grid;
    gap: 2.5rem;
  }

  .booking h2 {
    color: var(--ivory);
    font-size: clamp(3rem, 1.8rem + 6vw, 6.5rem);
  }

  .booking .accent {
    color: var(--stone);
  }

  .booking-lede {
    margin-top: 1.75rem;
    max-width: 38ch;
    font-size: var(--text-lede);
    line-height: 1.5;
  }

  .booking-text h3 {
    margin-top: 2.5rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .booking-text h3 + p {
    margin-top: 0.5rem;
    max-width: 46ch;
    color: rgb(245 241 232 / 82%);
  }

  .booking-card {
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--card);
    color: var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 60px -30px rgb(10 25 18 / 45%);
  }

  .card-name {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .card-name > span {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .mark {
    width: 2rem;
    height: auto;
    color: var(--rust);
  }

  .name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
  }

  .place {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .times {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 1.25rem 0;
  }

  .times div + div {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }

  .times dt {
    font-size: var(--text-small);
    color: var(--ink-soft);
  }

  .times dd {
    margin: 0.2rem 0 0;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .booking-actions {
    display: grid;
    gap: 0.6rem;
  }

  .rules {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .rules h3 {
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0;
  }

  .rules ul {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .rules li {
    padding: 0.35rem 0.8rem;
    font-size: 0.875rem;
    background: var(--paper-deep);
    border-radius: 999px;
  }

  .booking-card :focus-visible {
    outline-color: var(--forest);
  }

  @media (min-width: 60em) {
    .booking-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(22rem, 1fr);
      gap: clamp(3rem, 7vw, 8rem);
      align-items: center;
    }
  }
</style>
