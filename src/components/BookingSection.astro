---
import { anchors, t, type Locale } from '@config/i18n';
import { activeProviders } from '@config/property';
import ExternalIcon from './ExternalIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const labels = { booking: tr.cta.booking, airbnb: tr.cta.airbnb } as const;
const rules = [tr.booking.checkIn, tr.booking.checkOut, tr.booking.noSmoking, tr.booking.noPets, tr.booking.noParties];
---

<section id={anchors[locale].booking} class="section booking on-dark" aria-labelledby="booking-title" data-bar-stop>
  <div class="container">
    <div class="booking-grid">
      <div class="booking-text" data-reveal>
        <span class="eyebrow">{tr.booking.label}</span>
        <h2 id="booking-title">{tr.booking.heading}</h2>
        <p>{tr.booking.body}</p>
        {
          activeProviders.length > 0 && (
            <div class="booking-actions">
              {activeProviders.map((provider, i) => (
                <a
                  class:list={['btn', i === 0 ? 'btn-light' : 'btn-outline-light']}
                  href={provider.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {labels[provider.id]}
                  <ExternalIcon />
                  <span class="visually-hidden">({tr.cta.newTab})</span>
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div class="booking-rules" data-reveal data-reveal-delay="80">
        <h3>{tr.booking.rulesHeading}</h3>
        <ul>
          {rules.map((rule) => <li>{rule}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .booking {
    background: var(--forest);
    color: var(--ivory);
  }

  .booking .eyebrow,
  .booking-rules h3 {
    color: var(--stone);
  }

  .booking h2 {
    color: var(--ivory);
  }

  .booking p {
    margin-top: 1.1rem;
    color: rgba(245, 241, 232, 0.86);
  }

  .booking-grid {
    display: grid;
    gap: 2.5rem;
  }

  .booking-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .booking-actions .btn {
    width: 100%;
  }

  .booking-rules h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .booking-rules ul {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .booking-rules li {
    padding: 0.55rem 0;
    border-top: 1px solid rgba(245, 241, 232, 0.16);
    color: rgba(245, 241, 232, 0.9);
  }

  @media (min-width: 30em) {
    .booking-actions .btn {
      width: auto;
    }
  }

  @media (min-width: 60em) {
    .booking-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
  }
</style>
