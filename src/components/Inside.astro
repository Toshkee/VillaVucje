---
import { anchors, t, type Locale } from '@config/i18n';
import { property } from '@config/property';
import { photoByRole } from '@config/media';
import Photo from './Photo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const large = photoByRole('inside-large');
const detail = photoByRole('inside-detail');
---

<section id={anchors[locale].house} class="section inside" aria-labelledby="inside-title">
  <div class="container">
    <div class="split">
      <h2 id="inside-title" data-reveal>
        {tr.inside.heading}
        <span class="accent">{tr.inside.headingAccent}</span>
      </h2>
      <div class="split-body" data-reveal data-reveal-delay="80">
        {tr.inside.body.map((p) => <p>{p}</p>)}
        <h3 class="amenities-title">{tr.inside.amenitiesHeading}</h3>
        <ul class="chips">
          {property.amenities.map((key) => <li>{tr.amenities[key]}</li>)}
        </ul>
      </div>
    </div>

    <div class="inside-photos">
      <figure class="inside-large" data-reveal>
        <div class="photo">
          <Photo photo={large} alt={tr.photos[large.key]} sizes="(min-width: 60em) 58vw, 100vw" />
        </div>
        <figcaption>{tr.captions[large.key]}</figcaption>
      </figure>

      <figure class="inside-detail" data-reveal data-reveal-delay="100">
        <div class="photo">
          <Photo
            photo={detail}
            alt={tr.photos[detail.key]}
            sizes="(min-width: 60em) 34vw, 100vw"
            widths={[480, 768, 1080]}
          />
        </div>
        <figcaption>{tr.captions[detail.key]}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .amenities-title {
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .inside-photos {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .inside-large .photo {
    aspect-ratio: 4 / 3;
  }

  .inside-detail .photo {
    aspect-ratio: 4 / 5;
  }

  @media (min-width: 48em) {
    .inside-photos {
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
      gap: clamp(1.25rem, 3vw, 2.5rem);
      align-items: start;
    }

    /* The portrait sits lower than the large photo, as if pinned by hand. */
    .inside-detail {
      margin-top: clamp(4rem, 10vw, 9rem);
    }
  }
</style>
