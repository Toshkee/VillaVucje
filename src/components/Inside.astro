---
import { anchors, t, type Locale } from '@config/i18n';
import { type AmenityKey } from '@config/property';
import { photoByRole } from '@config/media';
import Photo from './Photo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const large = photoByRole('inside-large');
const detail = photoByRole('inside-detail');
const amenityGroups: { title: string; items: AmenityKey[] }[] = [
  { title: tr.inside.amenityGroups.together, items: ['fireplace', 'kitchen', 'wifi', 'dishwasher'] },
  { title: tr.inside.amenityGroups.outside, items: ['garden', 'terrace', 'balcony', 'bbq'] },
  { title: tr.inside.amenityGroups.practical, items: ['parking', 'washer'] },
];
---

<section id={anchors[locale].house} class="section inside" aria-labelledby="inside-title">
  <div class="container">
    <div class="inside-grid">
      <div class="inside-text" data-reveal>
        <h2 id="inside-title">{tr.inside.heading}</h2>
        {tr.inside.body.map((p) => <p>{p}</p>)}
      </div>

      <figure class="photo inside-large" data-reveal>
        <Photo
          photo={large}
          alt={tr.photos.livingDining}
          sizes="(min-width: 60em) 56vw, 100vw"
        />
      </figure>

      <figure class="photo inside-detail" data-reveal data-reveal-delay="90">
        <Photo
          photo={detail}
          alt={tr.photos.fireplace}
          sizes="(min-width: 60em) 32vw, 100vw"
          widths={[480, 768, 1080]}
        />
      </figure>
    </div>

    <div class="amenities" data-reveal>
      <h3>{tr.inside.amenitiesHeading}</h3>
      <div class="amenity-groups">
        {amenityGroups.map((group) => (
          <div class="amenity-group">
            <h4>{group.title}</h4>
            <ul>{group.items.map((key) => <li>{tr.amenities[key]}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .inside-grid {
    display: grid;
    gap: 1.25rem;
  }

  .inside-text {
    max-width: 40rem;
    margin-bottom: 0.5rem;
  }

  .inside-text h2 + p {
    margin-top: 1.1rem;
  }

  figure {
    margin: 0;
  }

  .inside-large {
    aspect-ratio: 3 / 2;
  }

  .inside-detail {
    aspect-ratio: 4 / 5;
    max-height: 32rem;
  }

  .amenities {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-top: 1.25rem;
  }

  .amenities h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    color: var(--sage-text);
  }

  .amenity-groups {
    display: grid;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .amenity-group {
    padding: 1rem 0 0;
    border-top: 1px solid var(--stone-line);
  }

  .amenity-group h4 {
    margin: 0;
    font-size: var(--text-small);
    color: var(--rust-text);
  }

  .amenities ul {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 1rem;
  }

  .amenities li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--forest);
  }

  .amenities li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--rust);
  }

  @media (min-width: 60em) {
    .amenity-groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .inside-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      gap: 2rem 2.5rem;
      align-items: end;
    }

    .inside-text {
      grid-column: 1 / 8;
      grid-row: 1;
      align-self: start;
      margin-bottom: 1rem;
    }

    .inside-large {
      grid-column: 1 / 8;
      grid-row: 2;
    }

    /* Narrow portrait detail, bottom-aligned with the large photograph. */
    .inside-detail {
      grid-column: 8 / 13;
      grid-row: 1 / 3;
      max-height: none;
      aspect-ratio: 4 / 5;
    }
  }
</style>
