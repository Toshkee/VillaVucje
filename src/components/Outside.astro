---
import { t, type Locale } from '@config/i18n';
import { photoByRole } from '@config/media';
import Photo from './Photo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const garden = photoByRole('outside');
---

<section class="outside" aria-labelledby="outside-title">
  <div class="container">
    <div class="panel on-dark">
      <div class="panel-text" data-reveal>
        <h2 id="outside-title">
          {tr.outside.heading}
          <span class="accent">{tr.outside.headingAccent}</span>
        </h2>
        <div class="split-body">
          {tr.outside.body.map((p) => <p>{p}</p>)}
        </div>
        <ul class="chips">
          {tr.outside.highlights.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="panel-photo photo" data-reveal data-reveal-delay="100">
        <Photo photo={garden} alt={tr.photos[garden.key]} sizes="(min-width: 60em) 46vw, 100vw" />
        <span class="photo-tag">{tr.captions[garden.key]}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 5vw, 4.5rem);
    background: var(--forest);
    color: var(--cream);
    border-radius: var(--radius-lg);
  }

  .panel h2 {
    color: var(--cream);
  }

  .split-body {
    margin-top: 1.5rem;
  }

  .chips {
    margin-top: 2rem;
  }

  .panel-photo {
    aspect-ratio: 4 / 5;
    background: var(--forest-deep);
  }

  @media (min-width: 60em) {
    .panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 5vw, 5rem);
      align-items: center;
    }

    .panel-photo {
      aspect-ratio: 5 / 6;
    }
  }
</style>
