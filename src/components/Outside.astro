---
import { t, type Locale } from '@config/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
---

<section class="section section-band outside" aria-labelledby="outside-title">
  <div class="container">
    <div class="outside-grid">
      <div class="outside-text" data-reveal>
        <h2 id="outside-title">{tr.outside.heading}</h2>
        {tr.outside.body.map((p) => <p>{p}</p>)}
      </div>
      <ul class="outside-highlights" data-reveal data-reveal-delay="80">
        {tr.outside.highlights.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .outside-grid {
    display: grid;
    gap: 1.75rem;
  }

  .outside-text {
    max-width: 42rem;
  }

  .outside-text h2 + p {
    margin-top: 1.1rem;
  }

  .outside-highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    border-bottom: 1px solid var(--stone-line);
  }

  .outside-highlights li {
    display: flex;
    align-items: center;
    min-height: 4rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--stone-line);
    color: var(--forest);
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
  }

  @media (min-width: 60em) {
    .outside-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: center;
    }

  }
</style>
