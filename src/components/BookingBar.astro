---
import { t, type Locale } from '@config/i18n';
import { activeProviders } from '@config/property';
import ExternalIcon from './ExternalIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const labels = { booking: tr.cta.booking, airbnb: tr.cta.airbnb } as const;
---

{
  activeProviders.length > 0 && (
    <div class="booking-bar on-dark" data-booking-bar aria-hidden="true" inert>
      {activeProviders.map((provider, i) => (
        <a
          class:list={['btn', i === 0 ? 'btn-light' : 'btn-outline-light']}
          href={provider.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {labels[provider.id]}
          <ExternalIcon />
          <span class="visually-hidden">({tr.cta.newTab})</span>
        </a>
      ))}
    </div>
  )
}

<style>
  .booking-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: none;
    gap: 0.6rem;
    padding: 0.7rem var(--gutter) calc(0.7rem + env(safe-area-inset-bottom, 0px));
    background: var(--forest);
    box-shadow: 0 -8px 24px -12px rgba(37, 41, 34, 0.5);
    transform: translateY(100%);
    transition: transform var(--dur) var(--ease);
  }

  .booking-bar .btn {
    flex: 1;
    min-height: 2.85rem;
  }

  html.js .booking-bar {
    display: flex;
  }

  .booking-bar.is-visible {
    transform: none;
  }

  /* The header shows its own booking button from 60em up. */
  @media (min-width: 60em) {
    html.js .booking-bar {
      display: none;
    }
  }
</style>

<script>
  import { initBookingBar } from '@scripts/booking-bar';
  initBookingBar();
</script>
