---
import { t, type Locale } from '@config/i18n';
import { anchors } from '@config/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const a = anchors[locale];
---

{
  (
    <div class="booking-bar on-dark" data-booking-bar aria-hidden="true" inert>
      <a class="btn btn-light" href={`#${a.booking}`}>{tr.cta.availability}</a>
    </div>
  )
}

<style>
  .booking-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: none;
    gap: 0.6rem;
    padding: 0.7rem var(--gutter) calc(0.7rem + env(safe-area-inset-bottom, 0px));
    background: var(--forest);
    box-shadow: 0 -8px 24px -12px rgba(37, 41, 34, 0.5);
    transform: translateY(100%);
    transition: transform var(--dur) var(--ease);
  }

  .booking-bar .btn {
    flex: 1;
    max-width: 32rem;
    margin-inline: auto;
    min-width: 0;
    padding-inline: 0.65rem;
    min-height: 2.85rem;
  }

  html.js .booking-bar {
    display: flex;
  }

  .booking-bar.is-visible {
    transform: none;
  }

  /* The header shows its own booking button from 60em up. */
  @media (min-width: 60em) {
    html.js .booking-bar {
      display: none;
    }
  }
</style>

<script>
  import { initBookingBar } from '@scripts/booking-bar';
  initBookingBar();
</script>
