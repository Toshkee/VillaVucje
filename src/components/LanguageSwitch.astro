---
/**
 * Both languages side by side with the current one marked, so the control
 * reads as a choice. A single link to the other language looked like a label
 * for the page you were already on.
 */
import { langTag, localeBadge, localeName, localePath, locales, t, type Locale } from '@config/i18n';

interface Props {
  locale: Locale;
  /** `badge` fits the header bar (CG / EN); `full` spells the languages out. */
  variant?: 'badge' | 'full';
  /** Colours for a dark background. */
  dark?: boolean;
}

const { locale, variant = 'badge', dark = false } = Astro.props;
const tr = t(locale);
const labelFor = (l: Locale): string => (variant === 'badge' ? localeBadge[l] : localeName[l]);
---

<div class:list={['lang-switch', `is-${variant}`, { 'is-dark': dark }]} role="group" aria-label={tr.nav.langAria}>
  {
    locales.map((l) =>
      l === locale ? (
        <span class="lang-option is-current" aria-current="true">
          {labelFor(l)}
          <span class="visually-hidden"> — {tr.meta.switchTo[l]}</span>
        </span>
      ) : (
        <a class="lang-option" href={localePath[l]} hreflang={langTag[l]} lang={langTag[l]} aria-label={tr.meta.switchTo[l]} data-nav-link>
          {labelFor(l)}
        </a>
      ),
    )
  }
</div>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .lang-switch .lang-option {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding-inline: 0.55rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }

  .lang-switch .is-current {
    color: var(--ink);
  }

  .lang-switch .is-current::after {
    content: '';
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    bottom: 0.6rem;
    height: 1.5px;
    background: var(--forest);
  }

  .lang-switch a.lang-option:hover {
    color: var(--ink);
  }

  .lang-switch.is-dark .lang-option {
    color: rgb(245 241 232 / 60%);
  }

  .lang-switch.is-dark .is-current,
  .lang-switch.is-dark a.lang-option:hover {
    color: var(--cream);
  }

  .lang-switch.is-dark .is-current::after {
    background: var(--stone);
  }
</style>
