---
import { anchors, localePath, t, type Locale } from '@config/i18n';
import LanguageSwitch from './LanguageSwitch.astro';
import { activeProviders, contact, property, social } from '@config/property';
import ExternalIcon from './ExternalIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const year = new Date().getFullYear();
const base = localePath[locale];
const a = anchors[locale];
const providerName = { booking: 'Booking.com', airbnb: 'Airbnb' } as const;

const links = [
  { href: `${base}#${a.house}`, label: tr.nav.house },
  { href: `${base}#${a.gallery}`, label: tr.nav.gallery },
  { href: `${base}#${a.location}`, label: tr.nav.location },
];
---

<footer class="site-footer on-dark" data-bar-stop>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-name">Villa Vučje</p>
        <p class="footer-tagline">{tr.footer.tagline}</p>
        <p class="footer-address">{property.locality}, {property.postalCode} {property.town}, {property.countryName[locale]}</p>
      </div>

      <div>
        <ul class="footer-list">
          {
            links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">{tr.footer.bookHeading}</h2>
        <ul class="footer-list">
          {
            activeProviders.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener noreferrer">
                  {providerName[p.id]}
                  <ExternalIcon />
                  <span class="visually-hidden">({tr.cta.newTab})</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={social.instagram.url} target="_blank" rel="noopener noreferrer">
              {tr.footer.instagram}
              <ExternalIcon />
              <span class="visually-hidden">({tr.cta.newTab})</span>
            </a>
          </li>
          {contact.email && (
            <li>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </li>
          )}
          {contact.phone && (
            <li>
              <a href={`tel:${contact.phone.replace(/\s+/g, '')}`}>{contact.phone}</a>
            </li>
          )}
          {contact.whatsapp && (
            <li>
              <a href={`https://wa.me/${contact.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer">
                WhatsApp
              </a>
            </li>
          )}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">{tr.footer.languageHeading}</h2>
        <LanguageSwitch locale={locale} variant="full" dark />
      </div>
    </div>

    <div class="footer-legal">
      <p>© {year} {property.name}. {tr.footer.rights}</p>
      <p>@{social.instagram.handle}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(3.5rem, 7vw, 6rem) 0 1.5rem;
    background: var(--forest-deep);
    color: var(--cream);
    font-size: var(--text-small);
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
  }

  .footer-name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(2.75rem, 2rem + 4vw, 5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--cream);
  }

  .footer-tagline {
    margin-top: 1.25rem;
    max-width: 34ch;
    font-size: 1rem;
    color: rgb(245 241 232 / 80%);
  }

  .footer-address {
    margin-top: 0.5rem;
    color: rgb(245 241 232 / 55%);
  }

  .footer-heading {
    margin-bottom: 0.5rem;
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0;
    color: rgb(245 241 232 / 55%);
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    font-size: 1rem;
    color: var(--cream);
    text-decoration: none;
  }

  .footer-list a:hover {
    color: var(--stone);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.25rem;
    border-top: 1px solid rgb(245 241 232 / 12%);
    color: rgb(245 241 232 / 55%);
  }

  @media (min-width: 48em) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }
</style>
