---
import { anchors, localePath, t, type Locale } from '@config/i18n';
import LanguageSwitch from './LanguageSwitch.astro';
import Arrow from './Arrow.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const base = localePath[locale];
const a = anchors[locale];

const links = [
  { href: `${base}#${a.house}`, label: tr.nav.house },
  { href: `${base}#${a.gallery}`, label: tr.nav.gallery },
  { href: `${base}#${a.location}`, label: tr.nav.location },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href={base}>
      <svg class="mark" aria-hidden="true" viewBox="0 0 28 22" fill="none">
        <path d="M2 14 14 3l12 11" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>
        <path d="M6 12.5V20h16v-7.5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
      </svg>
      <span class="wordmark-text">
        <span class="wordmark-name">Villa Vučje</span>
        <span class="wordmark-place">Crkvine · Kolašin</span>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
      data-label-open={tr.nav.menuOpen}
      data-label-close={tr.nav.menuClose}
    >
      <span data-menu-label>{tr.nav.menuOpen}</span>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    </button>

    <nav id="site-nav" class="nav" aria-label={tr.nav.menuAria} data-nav>
      <ul class="nav-list">
        {
          links.map((l) => (
            <li class="nav-item">
              <a href={l.href} data-nav-link>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav-end">
        <LanguageSwitch locale={locale} />
        <a class="btn btn-dark nav-cta" href={`${base}#${a.booking}`} data-nav-link>
          {tr.cta.availability}
          <Arrow />
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(245 241 232 / 88%);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid rgb(37 41 34 / 8%);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    text-decoration: none;
    min-height: 2.75rem;
  }

  .wordmark:hover {
    color: var(--ink);
  }

  .mark {
    width: 1.6rem;
    height: auto;
    color: var(--forest);
  }

  .wordmark-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .wordmark-name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
  }

  .wordmark-place {
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.4rem 1rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    font-weight: 500;
    color: var(--ink);
  }

  .menu-icon {
    position: relative;
    width: 1.1rem;
    height: 0.7rem;
  }

  .menu-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease), top var(--dur-fast) var(--ease);
  }

  .menu-icon span:first-child {
    top: 0;
  }

  .menu-icon span:last-child {
    top: calc(100% - 1.5px);
  }

  .menu-toggle[aria-expanded='true'] .menu-icon span:first-child {
    top: calc(50% - 0.75px);
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-icon span:last-child {
    top: calc(50% - 0.75px);
    transform: rotate(-45deg);
  }

  /* Phones: the nav drops below the bar as a card. */
  .nav {
    display: none;
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: calc(100% + 0.5rem);
    padding: 0.75rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 48px -24px rgb(37 41 34 / 35%);
  }

  .nav.is-open {
    display: block;
  }

  html:not(.js) .menu-toggle {
    display: none;
  }

  html:not(.js) .nav {
    display: block;
    position: static;
    box-shadow: none;
    border: 0;
    background: none;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: 0.75rem;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .nav-end {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 0.75rem 0.5rem;
  }

  .nav-cta {
    width: 100%;
  }

  @media (min-width: 60em) {
    .menu-toggle {
      display: none;
    }

    .nav {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: space-between;
      position: static;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
    }

    .nav-list {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      margin-inline: auto;
      padding: 0.3rem;
      background: rgb(250 247 240 / 70%);
      border: 1px solid var(--line);
      border-radius: 999px;
    }

    .nav-item a {
      min-height: 2.5rem;
      padding-inline: 1.1rem;
      font-size: 0.95rem;
      letter-spacing: 0;
      border: 0;
      border-radius: 999px;
      transition: background-color var(--dur-fast) var(--ease);
    }

    .nav-item a:hover {
      background: var(--paper-deep);
      color: var(--ink);
    }

    .nav-end {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      padding: 0;
    }

    .nav-cta {
      width: auto;
      min-height: 2.75rem;
      padding: 0.5rem 1.2rem;
      font-size: 0.95rem;
    }
  }
</style>

<script>
  import { initNav } from '@scripts/nav';
  initNav();
</script>
