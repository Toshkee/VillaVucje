---
import { t, type Locale } from '@config/i18n';
import { bookingReviews } from '@config/property';
import ExternalIcon from './ExternalIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const score = locale === 'sr' ? String(bookingReviews.score).replace('.', ',') : String(bookingReviews.score);
---

<section class="section reviews" aria-labelledby="reviews-title">
  <div class="container">
    <h2 id="reviews-title" class="reviews-title" data-reveal>
      {tr.reviews.heading}
      <span class="accent">{tr.reviews.headingAccent}</span>
    </h2>

    <ul class="review-grid">
      <li class="score-card" data-reveal>
        <p class="score" aria-label={`${tr.reviews.scoreLabel}: ${score} / 10`}>
          <strong>{score}</strong><span aria-hidden="true">/10</span>
        </p>
        <p class="score-meta">
          <b>Booking.com</b>
          {tr.reviews.count}
        </p>
      </li>
      {
        bookingReviews.excerpts.map((review, i) => (
          <li class="review" data-reveal data-reveal-delay={String((i + 1) * 70)}>
            <blockquote>“{tr.reviews.excerpts[review.key]}”</blockquote>
            <p class="guest">
              <span class="initial" aria-hidden="true">
                {review.guest.charAt(0)}
              </span>
              <span>
                <strong>{review.guest}</strong>
                <span class="country">{review.country[locale]}</span>
              </span>
            </p>
          </li>
        ))
      }
    </ul>

    <div class="reviews-foot" data-reveal>
      <p>{tr.reviews.sourceNote}</p>
      <a class="btn btn-secondary" href={bookingReviews.url} target="_blank" rel="noopener noreferrer">
        {tr.reviews.readAll}
        <ExternalIcon />
        <span class="visually-hidden">({tr.cta.newTab})</span>
      </a>
    </div>
  </div>
</section>

<style>
  .reviews-title {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .review-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .review-grid > li {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 16rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-radius: var(--radius-lg);
  }

  .score-card {
    background: var(--forest);
    color: var(--ivory);
  }

  .score {
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
    line-height: 0.9;
  }

  .score strong {
    font-size: clamp(4.5rem, 3rem + 5vw, 7rem);
    font-weight: 400;
    letter-spacing: -0.06em;
  }

  .score span {
    font-size: 1.25rem;
    opacity: 0.8;
  }

  .score-meta {
    display: flex;
    flex-direction: column;
    font-size: var(--text-small);
    line-height: 1.4;
    color: rgb(245 241 232 / 82%);
  }

  .score-meta b {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ivory);
  }

  .review {
    background: var(--card);
    border: 1px solid var(--line);
  }

  blockquote {
    margin: 0;
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.6rem);
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .guest {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-small);
    line-height: 1.35;
  }

  .guest > span:last-child {
    display: flex;
    flex-direction: column;
  }

  .guest strong {
    font-weight: 600;
  }

  .initial {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--paper-deep);
    color: var(--ink);
    font-weight: 500;
  }

  .country {
    color: var(--ink-soft);
  }

  .reviews-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    font-size: var(--text-small);
    color: var(--ink-soft);
  }

  @media (min-width: 40em) {
    .review-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .review-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
