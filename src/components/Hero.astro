---
import { anchors, t, type Locale } from '@config/i18n';
import { activeProviders } from '@config/property';
import { heroVideo, photoByRole } from '@config/media';
import { getHeroSources, HERO_PORTRAIT_MEDIA } from '../lib/hero';
import ExternalIcon from './ExternalIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const labels = { booking: tr.cta.booking, airbnb: tr.cta.airbnb } as const;
const hero = photoByRole('hero');
const { landscape, portrait } = await getHeroSources();
const heroStyle = `--focal-mobile:${hero.focalMobile.x}% ${hero.focalMobile.y}%;--focal-desktop:${hero.focalDesktop.x}% ${hero.focalDesktop.y}%`;
const a = anchors[locale];
const videoLabels =
  locale === 'sr' ? { pause: 'Zaustavi video', play: 'Pokreni video' } : { pause: 'Pause video', play: 'Play video' };
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero-media" data-hero-video={heroVideo ? '' : undefined}>
    {/* A portrait rendition on phones keeps the garden and mountain in frame. */}
    <picture>
      {portrait && <source media={HERO_PORTRAIT_MEDIA} type="image/avif" srcset={portrait.avif} sizes="100vw" />}
      {portrait && <source media={HERO_PORTRAIT_MEDIA} type="image/webp" srcset={portrait.webp} sizes="100vw" />}
      {portrait && (
        <source media={HERO_PORTRAIT_MEDIA} type="image/jpeg" srcset={portrait.fallbackSrcset} sizes="100vw" />
      )}
      <source type="image/avif" srcset={landscape.avif} sizes="100vw" />
      <source type="image/webp" srcset={landscape.webp} sizes="100vw" />
      <img
        src={landscape.fallbackSrc}
        srcset={landscape.fallbackSrcset}
        sizes="100vw"
        width={landscape.width}
        height={landscape.height}
        alt={tr.photos[hero.key]}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        class="photo-img hero-img"
        style={heroStyle}
      />
    </picture>
    {
      heroVideo && (
        <>
          <video class="hero-video" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1">
            {heroVideo.webm && <source data-src={heroVideo.webm} type="video/webm" />}
            <source data-src={heroVideo.mp4} type="video/mp4" />
          </video>
          <button
            class="video-toggle"
            type="button"
            hidden
            data-video-toggle
            data-label-pause={videoLabels.pause}
            data-label-play={videoLabels.play}
          >
            {videoLabels.pause}
          </button>
        </>
      )
    }
  </div>

  <div class="container hero-content">
    <div class="hero-panel">
      <h1 id="hero-title" class="hero-in">{tr.hero.title}</h1>
      <p class="hero-location hero-in">{tr.hero.location}</p>
      <p class="lede hero-in">{tr.hero.lede}</p>
      <div class="hero-actions hero-in">
        {
          activeProviders.map((provider, i) => (
            <a
              class:list={['btn', i === 0 ? 'btn-light' : 'btn-outline-light']}
              href={provider.url}
              target="_blank"
              rel="noopener noreferrer"
              data-hero-cta={i === 0 ? '' : undefined}
            >
              {labels[provider.id]}
              <ExternalIcon />
              <span class="visually-hidden">({tr.cta.newTab})</span>
            </a>
          ))
        }
        <a class="text-link" href={`#${a.house}`}>{tr.cta.explore}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    isolation: isolate;
    min-height: clamp(36rem, calc(100svh - 4.5rem), 52rem);
    color: var(--ivory);
    background: var(--forest-deep);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(12 27 20 / 5%) 10%, rgb(12 27 20 / 22%) 35%, rgb(12 27 20 / 82%) 100%);
  }

  .hero-media picture {
    display: contents;
  }

  .hero-media .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Keep the build-time portrait crop centred. */
  .hero-media .hero-img {
    object-position: 50% 50%;
  }

  @media (min-width: 48em) {
    .hero-media .hero-img {
      object-position: var(--focal-desktop);
    }
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease);
  }

  .hero-media.is-playing .hero-video {
    opacity: 1;
  }

  .video-toggle {
    position: absolute;
    right: 1rem;
    top: 1rem;
    z-index: 3;
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    background: rgba(245, 241, 232, 0.92);
    color: var(--forest);
    border: 0;
    border-radius: var(--radius);
    font-weight: 600;
    cursor: pointer;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    padding-top: 10rem;
    padding-bottom: clamp(2rem, 5vw, 5rem);
    pointer-events: none;
  }

  .hero-panel {
    width: 100%;
    max-width: 43rem;
    pointer-events: auto;
  }

  .hero-panel h1 {
    color: var(--ivory);
    max-width: 13ch;
    letter-spacing: -0.045em;
    text-shadow: 0 2px 20px rgb(0 0 0 / 15%);
  }

  .hero-location {
    margin-top: 1.25rem;
    color: var(--ivory);
    font-size: 1rem;
  }

  .hero-panel .lede {
    margin-top: 1.1rem;
    max-width: 42ch;
    color: var(--ivory);
  }

  .hero-actions .text-link {
    color: var(--ivory);
  }

  .hero-actions .text-link:hover {
    text-decoration: underline;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.6rem;
  }

  .hero-actions .btn {
    width: 100%;
  }

  @media (min-width: 30em) {
    .hero-actions .btn {
      width: auto;
    }
  }

  @media (min-width: 60em) {
    .hero::after {
      background:
        linear-gradient(90deg, rgb(12 27 20 / 65%), rgb(12 27 20 / 12%) 70%),
        linear-gradient(0deg, rgb(12 27 20 / 58%), transparent 75%);
    }
  }

  /* Entrance: short, small travel, three steps at most. */
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-in {
    animation: hero-in var(--dur-slow) var(--ease) both;
  }

  .hero-in:nth-child(2) {
    animation-delay: 70ms;
  }

  .hero-in:nth-child(3) {
    animation-delay: 140ms;
  }

  .hero-in:nth-child(4) {
    animation-delay: 200ms;
  }
</style>

{
  heroVideo && (
    <script>
      import { initHeroVideo } from '@scripts/hero-video';
      initHeroVideo();
    </script>
  )
}
