---
import { t, type Locale } from '@config/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const items = [
  tr.facts.location,
  tr.facts.guests,
  tr.facts.bedrooms,
  tr.facts.bathrooms,
  tr.facts.area,
  tr.facts.parking,
];
---

<section class="facts container" aria-labelledby="facts-title" data-reveal>
  <h2 id="facts-title" class="visually-hidden">{tr.facts.heading}</h2>
  <dl class="facts-row">
    {
      items.map((item) => (
        <div class="fact">
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .facts {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .facts-row {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    background: var(--ivory-deep);
    border-radius: var(--radius);
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  dt {
    font-size: var(--text-small);
    color: var(--sage-text);
  }

  dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    color: var(--charcoal);
  }

  @media (min-width: 48em) {
    .facts-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 60em) {
    .facts-row {
      grid-template-columns: 1.3fr 0.8fr 1fr 0.9fr 1fr 1.4fr;
      gap: 0 1.5rem;
    }
  }
</style>
