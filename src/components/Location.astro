---
import { anchors, t, type Locale } from '@config/i18n';
import { mapUrl } from '@config/property';
import { photoByRole } from '@config/media';
import ExternalIcon from './ExternalIcon.astro';
import Photo from './Photo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const street = photoByRole('location');
---

<section id={anchors[locale].location} class="section location on-dark" aria-labelledby="location-title">
  <div class="container">
    <div class="split">
      <h2 id="location-title" data-reveal>
        {tr.location.heading}
        <span class="accent">{tr.location.headingAccent}</span>
      </h2>
      <div class="split-body" data-reveal data-reveal-delay="80">
        {tr.location.body.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <div class="location-grid">
      <figure class="location-photo" data-reveal>
        <div class="photo">
          <Photo photo={street} alt={tr.photos[street.key]} sizes="(min-width: 60em) 62vw, 100vw" />
        </div>
        <figcaption>{tr.captions[street.key]}</figcaption>
      </figure>

      <div class="location-card" data-reveal data-reveal-delay="100">
        <dl>
          <div class="row">
            <dt>{tr.location.distanceLabel}</dt>
            <dd class="big">{tr.location.distanceValue}</dd>
          </div>
          <div class="row">
            <dt>{tr.location.accessLabel}</dt>
            <dd>{tr.location.accessValue}</dd>
          </div>
          <div class="row">
            <dt>{tr.location.addressLabel}</dt>
            <dd>{tr.location.address}</dd>
          </div>
        </dl>
        <a class="btn btn-light" href={mapUrl} target="_blank" rel="noopener noreferrer">
          {tr.location.mapLink}
          <ExternalIcon />
          <span class="visually-hidden">({tr.cta.newTab})</span>
        </a>
        <p class="note">{tr.location.mapNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    background: var(--forest-deep);
    color: var(--cream);
  }

  .location h2 {
    color: var(--cream);
  }

  .location figcaption {
    color: rgb(245 241 232 / 60%);
  }

  .location-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .location-photo .photo {
    aspect-ratio: 3 / 2;
    background: var(--forest);
  }

  .location-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: rgb(245 241 232 / 6%);
    border: 1px solid rgb(245 241 232 / 12%);
    border-radius: var(--radius-lg);
  }

  dl {
    margin: 0;
  }

  .row {
    padding: 1rem 0;
    border-bottom: 1px solid rgb(245 241 232 / 12%);
  }

  .row:first-child {
    padding-top: 0;
  }

  dt {
    font-size: var(--text-small);
    color: rgb(245 241 232 / 60%);
  }

  dd {
    margin: 0.3rem 0 0;
    font-size: 1.125rem;
    line-height: 1.4;
  }

  dd.big {
    font-size: clamp(2.75rem, 2rem + 3vw, 4rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .note {
    font-size: var(--text-small);
    color: rgb(245 241 232 / 60%);
  }

  @media (min-width: 60em) {
    .location-grid {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      gap: clamp(1.25rem, 3vw, 2.5rem);
      align-items: start;
    }
  }
</style>
